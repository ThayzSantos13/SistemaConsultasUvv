@model SistemaConsultasUVV.Models.Consulta
@{ ViewData["Title"] = "Agendar Consulta"; }
<h2>Agendar Consulta</h2>
<form asp-action="Create" method="post">
    <div class="mb-3"><label asp-for="Especialidade"></label><input asp-for="Especialidade" class="form-control" /></div>
    <div class="mb-3"><label asp-for="DataHora"></label><input asp-for="DataHora" type="datetime-local" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Descricao"></label><textarea asp-for="Descricao" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-success">Salvar</button>
</form>