@model SistemaConsultasUVV.Models.Consulta
@{ ViewData["Title"] = "Editar Consulta"; }

<h2>Editar Consulta</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Especialidade"></label>
        <input asp-for="Especialidade" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DataHora"></label>
        <input asp-for="DataHora" type="datetime-local" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>